---
import { Image } from 'astro:assets';
import Layout from '../components/Layout.astro';
import Railing from '../components/Railing.astro';
import LodgeScene from '../components/LodgeScene.astro';
import Reef from '../components/Reef.astro';
import RoomPlan from '../components/RoomPlan.astro';
import PlanIcon from '../components/PlanIcon.astro';
import Folio from '../components/Folio.astro';
import { useT, path, type Lang } from '../i18n';
import { SITE, PLANS, WALKS, FROM_PRICE, BEACH, REVIEWS } from '../data/site';
import { MAX_ROOMS, money } from '../lib/stay';
import pool from '../assets/photos/pool.jpg';
import room from '../assets/photos/room3.jpg';
import roomGrey from '../assets/photos/room-grey.jpg';
import roomTwin from '../assets/photos/room-twin.jpg';
import roomDouble from '../assets/photos/room-double.jpg';
import roomTriple from '../assets/photos/room-triple.jpg';
import roomLamps from '../assets/photos/room-lamps.jpg';
const roomShots = [roomGrey, roomTwin, roomDouble, roomTriple, roomLamps, room];
import garden from '../assets/photos/garden.jpg';
import pool2 from '../assets/photos/pool2.jpg';
import restaurant from '../assets/photos/restaurant.jpg';
import terraceNight from '../assets/photos/terrace-night.jpg';
import bathroom from '../assets/photos/bathroom.jpg';
import poolside from '../assets/photos/poolside.jpg';
import balconyView from '../assets/photos/balcony-view.jpg';
import blueDoor from '../assets/photos/blue-door.jpg';
import walkway from '../assets/photos/walkway.jpg';
import poolBar from '../assets/photos/pool-bar.jpg';
const gallery = [
  { src: garden, k: 'garden', wide: true },
  { src: pool2, k: 'pool2', wide: true },
  { src: balconyView, k: 'balcony' },
  { src: poolBar, k: 'poolbar' },
  { src: blueDoor, k: 'door' },
  { src: walkway, k: 'walkway' },
  { src: restaurant, k: 'restaurant' },
  { src: terraceNight, k: 'night' },
  { src: bathroom, k: 'bathroom' },
  { src: poolside, k: 'poolside' },
];

interface Props { lang: Lang }
const { lang } = Astro.props;
const { t, branch } = useT(lang);
const strings = { rack: branch('rack'), folio: branch('folio'), plans: branch('plans'), today: branch('today') };
const slots = Array.from({ length: SITE.rooms }, (_, i) => i + 1);
const tilt = (n: number) => ((n * 37) % 9) - 4; // each key hangs a little differently
const spec = ['bed', 'guests', 'view', 'ac', 'minibar', 'tv'];
const place = (w: (typeof WALKS)[number]) => (lang === 'ar' ? w.ar : w.en);
const dive = WALKS[0];
const rays = Array.from({ length: 18 }, (_, i) => i * 20);
---
<Layout lang={lang} page="home" title={t('meta.title')} desc={t('meta.desc', { price: money(FROM_PRICE) })}>
  <script type="application/json" id="strings" set:html={JSON.stringify(strings)} />
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <symbol id="key" viewBox="0 0 24 60">
      <circle cx="12" cy="9" r="6.5" fill="none" stroke="currentColor" stroke-width="3.6" />
      <path d="M12 16V56M12 40H19M12 48H17M12 56H19" fill="none" stroke="currentColor" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round" />
    </symbol>
  </svg>

  <section class="hero" id="book">
    <div class="wrap hero-in">
      <div class="hero-text">
        <p class="kicker">{t('hero.kicker')}</p>
        <h1><span>{t('hero.h1a')}</span> <span class="hl">{t('hero.h1b')}</span></h1>
        <p class="hero-lead">{t('hero.lead', { price: money(FROM_PRICE) })}</p>
        <form class="bar" id="bar" onsubmit="return false">
          <label><span>{t('bar.in')}</span><input type="date" id="f-in" required /></label>
          <label><span>{t('bar.out')}</span><input type="date" id="f-out" required /></label>
          <label class="bar-rooms"><span>{t('bar.rooms')}</span>
            <select id="f-rooms">{Array.from({ length: MAX_ROOMS }, (_, i) => <option value={i + 1}>{i + 1}</option>)}</select>
          </label>
        </form>
        <p class="count" id="count" role="status" aria-live="polite"></p>
      </div>

      <div class="rack-wrap">
        <p class="sunprice">
          <svg viewBox="-80 -80 160 160" aria-hidden="true"><g class="rays">{rays.map((a) => <path d="M0 -62V-76" transform={`rotate(${a})`} />)}</g><circle r="56" /></svg>
          <span>{t('sticker.from')}</span><b>{money(FROM_PRICE)}</b><span>{t('sticker.unit')}</span>
        </p>
        <svg class="rope" viewBox="0 0 260 64" aria-hidden="true"><path d="M14 62L130 10L246 62" /><circle cx="130" cy="9" r="6" /></svg>
        <div class="rack" aria-labelledby="rack-title">
          <div class="rack-head">
            <h2 id="rack-title">{t('rack.title')}</h2>
            <span class="rack-dates" id="rack-dates"></span>
          </div>
          <ol class="slots" id="slots">
            {slots.map((n) => (
              <li class="slot" data-room={n} style={`--i:${n};--tilt:${tilt(n)}deg`}>
                <span class="hook"></span>
                <span class="label num">{n}</span>
                <span class="hang"><span class="fob num">{n}</span><svg class="key" width="18" height="45"><use href="#key" /></svg></span>
              </li>
            ))}
          </ol>
          <ul class="legend">
            <li><span class="fob"></span>{t('rack.legendFree')}</li>
            <li><span class="fob mine"></span>{t('rack.legendMine')}</li>
            <li><span class="hook"></span>{t('rack.legendTaken')}</li>
          </ul>
        </div>
      </div>
    </div>
    <div class="hero-rail"><Railing /></div>
  </section>

  <figure class="poolshot wrap">
    <Image src={pool} alt={t('photo.pool')} widths={[480, 800, 1280]} sizes="(min-width: 1240px) 1176px, 100vw" format="avif" quality={64} loading="eager" />
    <figcaption>{t('photo.note')}</figcaption>
  </figure>

  <section class="today">
    <div class="wrap">
      <h2>{t('today.title')}</h2>
      <dl class="facts">
        <div><dd id="fact-sunset">–</dd><dt>{t('today.sunset')}</dt></div>
        <div><dd id="fact-day">–</dd><dt>{t('today.daylight')}</dt></div>
        <div><dd id="fact-sea">–</dd><dt>{t('today.sea')}</dt></div>
        <div><dd>{t('today.diveV', { n: dive.min })}</dd><dt>{t('today.dive')}</dt></div>
      </dl>
    </div>
  </section>

  <section class="plans wrap">
    <div class="plans-main">
      <h2 class="sq">{t('plans.title')}</h2>
      <p class="lead">{t('plans.lead')}</p>
      <div class="cards" role="radiogroup" aria-label={t('plans.title')}>
        {PLANS.map((p) => (
          <label class="card">
            <input type="radio" name="plan" value={p.id} />
            <PlanIcon id={p.id} />
            <span class="card-name">{t(`plans.${p.id}`)}</span>
            <span class="card-note">{t(`plans.${p.id}Note`)}</span>
            <span class="card-price"><b>{money(p.price)}</b> {t('plans.unit')}</span>
            <span class="card-total" data-total={p.id}></span>
          </label>
        ))}
      </div>
      <ol class="direct-list" aria-label={t('direct.title')}>
        {['a', 'b', 'c'].map((k) => <li><b>{t(`direct.${k}`)}</b><span>{t(`direct.${k}T`)}</span></li>)}
      </ol>
    </div>

    <Folio lang={lang}>
      <a class="btn" id="cta" href={path(lang, 'book')} data-book={path(lang, 'book')}>{t('folio.cta')}</a>
    </Folio>
  </section>

  <section class="room" id="room">
    <div class="wrap room-in">
      <div class="room-text">
        <h2 class="sq">{t('room.title')}</h2>
        <p class="lead">{t('room.lead')}</p>
        <dl class="spec">
          {spec.map((k) => <div><dt>{t(`room.${k}`)}</dt><dd>{t(`room.${k}V`)}</dd></div>)}
        </dl>
      </div>
      <div class="room-side">
        <RoomPlan lang={lang} />
      </div>
    </div>
    <div class="wrap room-photos">
      {roomShots.map((r, i) => (
        <Image src={r} alt={t(`room.alt${i + 1}`)} widths={[360, 560, 680]} sizes="(min-width: 900px) 370px, 46vw" format="avif" quality={66} />
      ))}
    </div>
  </section>

  <section class="look wrap" id="photos">
    <h2 class="sq">{t('look.title')}</h2>
    <div class="look-grid">
      {gallery.map((g) => (
        <figure class:list={[{ wide: g.wide }]}>
          <Image src={g.src} alt={t(`look.${g.k}`)} widths={g.wide ? [480, 800, 1200] : [320, 520, 800]} sizes={g.wide ? '(min-width: 900px) 580px, 92vw' : '(min-width: 900px) 280px, 46vw'} format="avif" quality={62} />
          <figcaption>{t(`look.${g.k}`)}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="said" id="reviews">
    <div class="wrap">
      <h2 class="sq">{t('said.title')}</h2>
      <div class="said-grid">
        {REVIEWS.map((r) => (
          <figure>
            <blockquote>{lang === 'ar' ? r.ar : r.en}</blockquote>
            <figcaption><b dir="auto">{r.name}</b><span>{lang === 'ar' ? r.ctxAr : r.ctxEn} · {t('said.source')}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <LodgeScene />

  <section class="day" id="day">
    <Reef />
    <div class="wrap day-in">
      <h2>{t('day.title')}</h2>
      <p class="day-lead">{t('day.lead')}</p>
      <ol class="day-list">
        <li>
          <span class="when">{t('day.am')}</span>
          <h3>{t('day.amT')}</h3>
          <p>{t('day.amB')}</p>
          <ul class="chips"><li>{place(dive)} · {t('day.walk', { n: dive.min })}</li><li>{BEACH[lang]} · {t('day.walk', { n: BEACH.min })}</li></ul>
        </li>
        <li>
          <span class="when">{t('day.pm')}</span>
          <h3>{t('day.pmT')}</h3>
          <p>{t('day.pmB')}</p>
        </li>
        <li>
          <span class="when">{t('day.eve')}</span>
          <h3>{t('day.eveT')}</h3>
          <p>{t('day.eveB')}</p>
          <ul class="chips">{WALKS.slice(1).map((w) => <li>{place(w)} · {t('day.walk', { n: w.min })}</li>)}</ul>
        </li>
      </ol>
      <p class="trips"><b>{t('day.trips')}</b> {t('day.tripsT')} {t('day.airport')}</p>
    </div>
  </section>
</Layout>

<script>
  import { readStay, writeStay, quote, money, fmtDate, plural, iso, parse, plusDays, stayQuery, type Stay } from '../lib/stay';
  import { availability } from '../lib/api';
  import { sunTimes, hhmm, cairoOffsetHours } from '../lib/sun';
  import { $, fill, fillFolio, strings } from '../lib/ui';
  import { SITE, SEA_TEMP, PLANS } from '../data/site';

  const lang = document.documentElement.lang;
  const S = strings();
  const fIn = $<HTMLInputElement>('#f-in'), fOut = $<HTMLInputElement>('#f-out'), fRooms = $<HTMLSelectElement>('#f-rooms');
  const slots = [...document.querySelectorAll<HTMLElement>('.slot')];
  const radios = [...document.querySelectorAll<HTMLInputElement>('input[name=plan]')];
  const count = $('#count'), cta = $<HTMLAnchorElement>('#cta');
  const FEW = 3; // say "last rooms" from this many down

  // "Sharm, today": sunset, hours of daylight and the month's usual sea temperature
  const now = new Date();
  const offset = cairoOffsetHours(now);
  const sun = sunTimes(now, SITE.geo.lat, SITE.geo.lng, offset);
  $('#fact-sunset').textContent = hhmm(sun.set);
  $('#fact-day').textContent = ((sun.set - sun.rise) / 60).toFixed(1);
  $('#fact-sea').textContent = `${SEA_TEMP[now.getMonth()]}°`;
  // the drawing of the lodge: the sun sits where it is in Sharm's sky right now; after dark, the moon
  const clock = ((now.getUTCHours() + offset) * 60 + now.getUTCMinutes()) % 1440;
  const day = (clock - sun.rise) / (sun.set - sun.rise);
  const sunEl = $('#sun'), moonEl = $('#moon');
  if (day >= 0 && day <= 1) { // a point on the dotted arc M60 150 Q600 -90 1140 150
    sunEl.setAttribute('cx', String(60 + 1080 * day));
    sunEl.setAttribute('cy', String(150 - 480 * day * (1 - day)));
  } else { sunEl.setAttribute('hidden', ''); moonEl.removeAttribute('hidden'); }

  let stay = readStay();
  fIn.min = iso(new Date());

  async function render() {
    fIn.value = stay.in; fOut.value = stay.out; fRooms.value = String(stay.rooms);
    fOut.min = iso(plusDays(parse(stay.in), 1));
    for (const r of radios) r.checked = r.value === stay.plan;
    $('#rack-dates').textContent = `${fmtDate(stay.in, lang)} – ${fmtDate(stay.out, lang)}`;

    // prices on the three cards and on the bill
    for (const p of PLANS) {
      const pq = quote(stay, p.id);
      $(`[data-total=${p.id}]`).textContent = pq.onRequest ? '' : fill(S.plans.total, { total: money(pq.total) });
    }
    const q = fillFolio(document, stay, S, lang);

    // the key board
    let free: number[];
    try { free = await availability(stay); } catch (e) {
      count.textContent = fill(S.rack.error, { msg: e instanceof Error ? e.message : String(e) });
      count.classList.add('warn');
      throw e;
    }
    const enough = free.length >= stay.rooms;
    const mine = new Set(enough ? free.slice(0, stay.rooms) : []);
    for (const el of slots) {
      const n = Number(el.dataset.room);
      const isFree = free.includes(n);
      el.classList.toggle('taken', !isFree);
      el.classList.toggle('mine', mine.has(n));
      el.classList.remove('swing');
      el.setAttribute('aria-label', `${fill(S.rack.roomLabel, { n })}: ${isFree ? S.rack.legendFree : S.rack.legendTaken}`);
    }
    void document.body.offsetWidth; // restart the swing
    for (const el of slots) el.classList.add('swing');
    // no running count of free rooms: the guest learns whether there is a room, and when only a few are left
    count.textContent = !free.length ? S.rack.none : !enough ? fill(S.rack.short, { n: free.length }) : free.length <= FEW ? plural(S.rack.few, free.length, lang) : S.rack.free;
    count.classList.toggle('warn', !enough);

    // the button: on to the booking page, or WhatsApp when the dates have no price yet
    const off = !q.onRequest && !enough;
    cta.textContent = q.onRequest ? S.folio.ask : S.folio.cta;
    cta.href = q.onRequest
      ? `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(fill(S.folio.waAsk, { in: fmtDate(stay.in, lang), out: fmtDate(stay.out, lang) }))}`
      : `${cta.dataset.book}?${stayQuery(stay)}`;
    cta.target = q.onRequest ? '_blank' : '';
    cta.classList.toggle('off', off);
    cta.setAttribute('aria-disabled', String(off));
  }

  const update = (patch: Partial<Stay>) => { stay = writeStay({ ...stay, ...patch }); render(); };
  fIn.addEventListener('change', () => {
    // moving check-in keeps the length of the stay
    const len = Math.round((+parse(stay.out) - +parse(stay.in)) / 864e5);
    if (fIn.value) update({ in: fIn.value, out: iso(plusDays(parse(fIn.value), len)) });
  });
  fOut.addEventListener('change', () => fOut.value && update({ out: fOut.value }));
  fRooms.addEventListener('change', () => update({ rooms: Number(fRooms.value) }));
  for (const r of radios) r.addEventListener('change', () => update({ plan: r.value as Stay['plan'] }));
  cta.addEventListener('click', (e) => {
    if (!cta.classList.contains('off')) return;
    e.preventDefault(); // not enough rooms: back to the dates
    $('#bar').scrollIntoView({ behavior: 'smooth', block: 'center' });
  });

  render();
</script>
