---
import { LANGS, type Lang, type PageKey } from '../i18n';
import Home from '../views/Home.astro';
import Book from '../views/Book.astro';
import Mine from '../views/Mine.astro';

export function getStaticPaths() {
  const pages: [PageKey, string][] = [['home', ''], ['book', 'book'], ['mine', 'booking']];
  return LANGS.flatMap(({ code }) => pages.map(([page, slug]) => ({
    params: { path: [code === 'en' ? 'en' : '', slug].filter(Boolean).join('/') || undefined },
    props: { lang: code, page },
  })));
}
const { lang, page } = Astro.props as { lang: Lang; page: PageKey };
---
{page === 'home' && <Home lang={lang} />}
{page === 'book' && <Book lang={lang} />}
{page === 'mine' && <Mine lang={lang} />}
