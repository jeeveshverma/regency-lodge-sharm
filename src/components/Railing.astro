---
/** The lodge's own balcony railing (blue bars under a scalloped arch), drawn as a section divider. */
const id = `rail-${Math.random().toString(36).slice(2, 8)}`;
---
<svg class="railing" height="34" width="100%" aria-hidden="true" focusable="false">
  <defs>
    <pattern id={id} width="56" height="34" patternUnits="userSpaceOnUse">
      <path d="M0 3H56M0 31H56" />
      <path d="M0 31C4 12 24 12 28 31C32 12 52 12 56 31" />
      <path d="M14 17V31M28 3V31M42 17V31M0 3V31" />
    </pattern>
  </defs>
  <rect width="100%" height="34" fill={`url(#${id})`} />
</svg>
<style>
  .railing { display: block; color: var(--cobalt); }
  .railing path { fill: none; stroke: currentColor; stroke-width: 2; }
</style>
