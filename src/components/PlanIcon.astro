---
/** A small drawing for each meal plan: a bed; a cup under the morning sun; the cup and a covered plate under the moon. */
interface Props { id: 'ro' | 'bb' | 'hb' }
const { id } = Astro.props;
const cup = 'M6 18h18v7a8 8 0 0 1 -8 8h-2a8 8 0 0 1 -8 -8zM24 20h3a4 4 0 0 1 0 8h-3M11 12q2 -3 0 -6M18 12q2 -3 0 -6';
---
<svg class="plan-icon" viewBox="0 0 76 40" width="76" height="40" aria-hidden="true" focusable="false">
  {id === 'ro' && <path d="M6 36V8M6 24h52v12M6 30h52M12 24v-5a3 3 0 0 1 3 -3h10a3 3 0 0 1 3 3v5" />}
  {id === 'bb' && <g><path d={cup} /><circle cx="52" cy="20" r="6" /><path d="M52 8v3M52 29v3M40 20h3M61 20h3M43.5 11.5l2 2M58.5 26.5l2 2M43.5 28.5l2 -2M58.5 13.5l2 -2" /></g>}
  {id === 'hb' && <g><path d={cup} /><path d="M38 33h30M41 33a12 12 0 0 1 24 0M53 21v-3" /><path d="M66 3a6 6 0 1 0 6 8a5 5 0 0 1 -6 -8z" /></g>}
</svg>
<style>
  .plan-icon { color: inherit; }
  .plan-icon :is(path, circle) { fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
</style>
